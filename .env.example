# Kotak Neo Trade API — copy to .env and fill in (never commit .env)

# Required: API key style value from Kotak developer portal / app
KOTAK_AUTHORIZATION=your-authorization-uuid

# Required: same as Neo Fin Key in Kotak docs (often neotradeapi)
KOTAK_NEO_FIN_KEY=neotradeapi

# Login credentials (required only if DB token refresh fallback is needed)
KOTAK_MOBILE_NUMBER=+919999999999
KOTAK_UCC=YOURUCC
KOTAK_MPIN=your-mpin
KOTAK_TOTP_SECRET=BASE32SECRET

# Optional: persist session JWT to disk to skip TOTP until expiry
KOTAK_SESSION_PATH=./data/kotak-session.json

# MySQL auth source (preferred)
# App first reads AccessToken/ValidatedToken + SessionId from this row.
# If invalid/expired, app re-logins and writes updated tokens back to same row.
DB_HOST=127.0.0.1
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_AUTH_TABLE=TradeApiAuthKotak
DB_AUTH_ROW_ID=1

# HSM market data (binary WebSocket)
KOTAK_HSM_URL=wss://mlhsm.kotaksecurities.com
KOTAK_HSM_CHANNEL=1

# HSI order feed (JSON WebSocket) — default GDC
KOTAK_HSI_URL=wss://mis.kotaksecurities.com/realtime
KOTAK_HSI_HEARTBEAT_MS=30000

# JWT field to use for HSI auth (ValidatedToken after tradeApiValidate)
KOTAK_HSI_TOKEN_KEY=ValidatedToken

# Index LTP: ampersand-separated segments from Kotak (see Neo_Autobot config)
# Example: nse_cm|Nifty 50&bse_cm|Sensex
KOTAK_INDICES=nse_cm|Nifty 50&bse_cm|Sensex

# Match index feed topic names to Nifty vs Sensex (substring, case-insensitive)
KOTAK_NIFTY_TOPIC_SUBSTR=Nifty
KOTAK_SENSEX_TOPIC_SUBSTR=Sensex

# Optional: extra Sensex index aliases to subscribe if Sensex LTP doesn't arrive.
# (Ampersand-separated)
KOTAK_SENSEX_FALLBACKS=bse_cm|SENSEX&bse_cm|S&P BSE SENSEX&bse_cm|BSE SENSEX

# Lot sizes for Rs PnL: (LTP - buyAvg) * lots * LOT_SIZE when KOTAK_QTY_IS_LOTS=true
KOTAK_NIFTY_LOT_SIZE=25
KOTAK_SENSEX_LOT_SIZE=20

# If true, order quantity (qt) is interpreted as number of lots; otherwise as units (contracts)
KOTAK_QTY_IS_LOTS=true

# HTTP server
PORT=4206
