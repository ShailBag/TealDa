{
  "name": "kotak-options-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time dashboard for Kotak Securities index options (Sensex/Nifty)",
  "main": "src/server.js",
  "scripts": {
    "build": "vite build --config client/vite.config.js",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch src/server.js",
    "dev:client": "vite build --config client/vite.config.js --watch",
    "start": "node src/server.js",
    "preview": "npm run build && npm start"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mysql2": "^3.20.0",
    "pako": "^2.1.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "speakeasy": "^2.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  }
}
